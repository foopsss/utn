# Regla para ignorar todo.
*

# Regla para no ignorar todo lo que tenga una extensión.
!*.*

# Regla para no ignorar directorios/carpetas.
!*/

# Regla para no ignorar los git hooks.
!git-hooks/pre-commit

# Regla para ignorar object files y unit files resultantes de compilar cosas
# con Free Pascal.
*.o
*.ppu

# Regla para ignorar ejecutables de Windows compilados con MinGW.
*.exe

# Regla para ignorar archivos de caché de Python y sus carpetas.
__pycache__/
*.pyc
*.pyo
